# ==============================================================================
# InternFlow Production & Local Environment Configuration Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Spring Boot Backend Server & Profiles
# ------------------------------------------------------------------------------
# Active Spring Profile: 'local' (H2 in-memory DB) or 'prod' (PostgreSQL)
SPRING_PROFILES_ACTIVE=prod

# Application server listening port (Render automatically provides $PORT)
PORT=8080

# Logging level (INFO, WARN, DEBUG)
LOGGING_LEVEL_COM_INTERNFLOW=INFO

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Cloud platforms (Render, Supabase, Neon) provide DATABASE_URL:
# e.g.: postgres://user:password@host:5432/dbname
DATABASE_URL=postgresql://internflow_user:super_secure_password@dpg-xxxxxxxxxx.render.com:5432/internflow_db

# Standard JDBC connection properties (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=internflow_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/internflow_db

# HikariCP Connection Pool
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# ------------------------------------------------------------------------------
# 3. Security & Authentication (JWT & CORS)
# ------------------------------------------------------------------------------
# 256-bit Hex or Base64 secret key for HS256 JWT signing
# Generate with: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# JWT Expiration in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# Comma-separated list of allowed frontend origins (NO trailing slashes)
# In production, specify your Render static site domain(s)
CORS_ALLOWED_ORIGINS=https://internflow-frontend.onrender.com,http://localhost:5173

# ------------------------------------------------------------------------------
# 4. Document & Resume Storage (Local Filesystem vs Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
# Storage engine type: 'local' or 's3'
STORAGE_TYPE=local

# Local disk storage path (used when STORAGE_TYPE=local)
UPLOAD_DIR=/app/storage

# Cloudflare R2 / AWS S3 object storage (used when STORAGE_TYPE=s3)
# For Cloudflare R2, format: https://<cloudflare_account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_NAME=internflow-documents
S3_ACCESS_KEY_ID=your_r2_or_aws_access_key_id
S3_SECRET_ACCESS_KEY=your_r2_or_aws_secret_access_key
S3_PATH_STYLE_ACCESS=true

# ------------------------------------------------------------------------------
# 5. Frontend Environment Variables (Vite)
# ------------------------------------------------------------------------------
# Public API base URL for the backend
# Must include /api path if your backend routes are prefixed with /api
VITE_API_BASE_URL=https://internflow-backend-39ak.onrender.com/api

# Enable demo credential quick-fill buttons on the login page in production
# (false = hidden for production security, true = enabled for preview/staging)
VITE_ENABLE_DEMO_LOGIN=false
