# InternFlow Frontend Environment Variables

# Base URL for Spring Boot backend API.
# Leave unset or empty in local development to use the Vite proxy (/api -> http://localhost:8080).
# In production (e.g., Render Static Site), set to your deployed backend URL:
# VITE_API_BASE_URL=https://internflow-backend.onrender.com/api
VITE_API_BASE_URL=

# Enable demo credential quick-fill buttons on the login page in production.
# Set to 'false' (default) for live production, or 'true' for review/staging/demo environments.
VITE_ENABLE_DEMO_LOGIN=false
